{
  "manifest_version": 3,
  "name": "SPU-BD 手动触发版",
  "version": "1.3", 
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": "icon16.png"
  },
  "content_scripts": [
    {
      "matches": ["*://ldp.lifewit.cn/*"],
      "js": ["content.js"]
    }
  ],
  "permissions": ["activeTab"],
  "host_permissions": ["*://ldp.lifewit.cn/*"]
}