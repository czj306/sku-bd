{
  "manifest_version": 3,
  "name": "SPU-BD 多标签战略版",
  "version": "2.1", 
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": "icon16.png",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://ldp.lifewit.cn/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["*://ldp.lifewit.cn/*"]
}